<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="14.0" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="main.java.com.javatesting.kinalproyect.controller.MainController">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0" />
    </padding>

    <TextField fx:id="txtCodigo" promptText="Ingresar código de producto..." />

    <Button fx:id="btnBuscar" text="Buscar" onAction="#handleBuscar" />

    <TableView fx:id="tablaResultado" prefHeight="220.0" prefWidth="420.0">
        <columns>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="100.0" />
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200.0" />
            <TableColumn fx:id="colPrecio" text="Precio" prefWidth="100.0" />
        </columns>
    </TableView>

    <Label fx:id="lblResultado" text="" wrapText="true" />

</VBox>